<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#183f35"><meta name="description" content="Чистый драйв — короткая браузерная игра Чистых Игр. Сортируй, собирай серии и возвращай природе цвет."><title>Чистый драйв — Чистые Игры</title><style>body{margin:0;min-height:100vh;display:grid;place-content:center;background:#183f35;color:#f6f7ee;font:17px/1.6 system-ui;text-align:center;padding:20px;box-sizing:border-box}h1{font-size:30px}button{font:inherit;padding:12px 20px;border:0;border-radius:14px;background:#d9f47a;color:#183f35}</style></head><body><main><h1>Чистый драйв</h1><p id="loading" role="status">Запускаем игру…</p><noscript>Для игры нужно включить JavaScript.</noscript></main>
<script id="game-data" type="application/octet-stream">



</script>
<script>
(async()=>{
try{
if(!('DecompressionStream' in window))throw new Error('Откройте игру в обновленном Safari или Chrome.');
const encoded=document.getElementById('game-data').textContent.trim();
const bytes=Uint8Array.from(atob(encoded),c=>c.charCodeAt(0));
const response=new Response(new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip')));
const html=await response.text();
if(!html.startsWith('<!doctype html>')||!html.includes('window.CleanGames='))throw new Error('Не удалось загрузить игру. Обновите страницу.');
document.open();document.write(html);document.close();
}catch(error){document.getElementById('loading').textContent=error.message||'Не удалось запустить игру. Обновите страницу.';const b=document.createElement('button');b.textContent='Обновить';b.onclick=()=>location.reload();document.querySelector('main').append(b);}
})();
</script></body></html>
